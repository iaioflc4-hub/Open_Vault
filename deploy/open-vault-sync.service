[Unit]
Description=Open_Vault — clasificación, enlaces y subida del vault a GitHub
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=__SERVICE_USER__
Group=__SERVICE_USER__
WorkingDirectory=__VAULT_PATH__
Environment=APP_DIR=__APP_DIR__
Environment=VAULT_PATH=__VAULT_PATH__
Environment=PYTHONUNBUFFERED=1
# Opcional: si para subir a GitHub hace falta una clave propia (por ejemplo una
# clave de despliegue), se escribe en /etc/openvault/git.env una línea como
#   GIT_SSH_COMMAND=ssh -i /etc/openvault/vault-deploy -o IdentitiesOnly=yes
# El HOME del usuario del servicio no es escribible, así que git no puede mirar
# su configuración global: todo lo que necesite va acá.
EnvironmentFile=-/etc/openvault/git.env
ExecStart=/bin/bash __APP_DIR__/deploy/open-vault-sync.sh
