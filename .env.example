# Copiá este archivo a .env y completá lo que falta. El .env nunca se versiona.
# Ninguna de estas claves es de pago: todo el procesamiento es local.

# --- Telegram (obligatorio) -------------------------------------------------
# 1. Hablá con @BotFather, mandá /newbot y copiá el token acá.
BOT_TOKEN=
# 2. Arrancá el bot, escribile /id y pegá tu número (podés poner varios, separados por coma).
ALLOWED_TELEGRAM_USER_IDS=

# --- Vault (dónde quedan las notas) ----------------------------------------
# Es una carpeta común de Markdown: Obsidian, Logseq, Foam o un repo git.
VAULT_PATH=/srv/obsidian/Open_Vault

# --- Límites y opciones ----------------------------------------------------
# Tamaño máximo de una descarga (video incluido). Telegram permite 20 MB por archivo.
MAX_DOWNLOAD_MB=18
# Tamaño máximo de la imagen principal de una página web.
MAX_IMAGE_MB=3
# Idiomas de Tesseract para el OCR. Instalá el paquete correspondiente (spa+eng).
OCR_LANGUAGE=spa+eng
# Bajar la imagen principal de la web para que la nota no sea solo texto.
FETCH_MAIN_IMAGE=true
# Sacar un cuadro del video como miniatura (necesita ffmpeg instalado).
VIDEO_THUMBNAILS=true
# Cuántos cuadros leer con OCR para sacar el texto que aparece en pantalla.
# Los cuadros son temporales: al vault va el texto, no las imágenes (0 lo apaga).
VIDEO_FRAMES=4

# --- Transcripción de audio y video (local, apagada por defecto) ------------
# Nada sale de tu servidor: el audio se transcribe en la misma máquina.
# 1. Instalá el motor:  /opt/openvault/.venv/bin/pip install faster-whisper
# 2. Encendela acá y reiniciá el servicio.
TRANSCRIPTION_ENGINE=
# TRANSCRIPTION_MODEL=tiny        # tiny es el más liviano; base/small mejoran la calidad
# TRANSCRIPTION_LANGUAGE=es
# TRANSCRIPTION_MEMORY_MB=600     # tope de memoria del proceso; 0 = sin tope
# TRANSCRIPTION_TIMEOUT=1800
